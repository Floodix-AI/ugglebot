# Ugglebot — miljövariabler
# Kopiera till .env och fyll i dina API-nycklar

# === API-nycklar (obligatoriska) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# === ElevenLabs röst ===
# Kör "python test_local.py voices" för att lista tillgängliga röster
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# === Barninställningar ===
CHILD_AGE=6
CHILD_NAME=
LANGUAGE=sv

# === Kostnadsgräns ===
DAILY_BUDGET_SEK=5.0

# === Avancerat ===
# LED_ENABLED=auto             # auto, true, false
# VAD_THRESHOLD=0.5            # Känslighet under inspelning (0.0-1.0)
# WAKE_VAD_THRESHOLD=0.7       # Känslighet för att vakna (högre = färre falska triggers)
# WAKE_SPEECH_DURATION_MS=600  # Tal-längd (ms) krävs för att vakna
# MAX_API_CALLS_PER_HOUR=30    # Säkerhetsgräns mot falska triggers
# SILENCE_DURATION=1.5         # Sek tystnad = slut på inspelning
# MAX_RECORDING_DURATION=30    # Max sek per inspelning
# SESSION_MAX_MINUTES=30       # Max session innan sömn
# IDLE_TIMEOUT_SECONDS=120     # Sek utan tal → sömn
# CONVERSATION_HISTORY_LENGTH=10
